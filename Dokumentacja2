3. Architektura i Struktura Danych
3.1 Stałe globalne
W projekcie zdefiniowano stałe globalne odpowiadające za kluczowe parametry rozgrywki. Ich zmiana w kodzie automatycznie dostosowuje logikę całej aplikacji:
| Nazwa stałej | Typ danych | Wartość | Opis funkcjonalny |
|---|---|---|---|
| ROZMIAR | const int | 10 | Określa wymiar boku kwadratowej planszy (10 \times 10 pól = 100 pól). |
| LICZBA_STATKOW | const int | 5 | Definiuje liczbę jednostek morskich przysługujących każdemu z graczy. |
3.2 Oznaczenia symboliczne pól na planszy
Stan każdego pola na planszy opisany jest pojedynczym znakiem typu char:
 * . (Kropka): Pole puste, reprezentujące nieodkrytą wodę.
 * S (Litera S): Statek gracza (widoczny wyłącznie na planszy gracza lub w trybie debugowania).
 * X (Litera X): Trafienie (zatopiony statek lub jego fragment).
 * O (Litera O): Pudło (strzał oddany w puste pole / wodę).
3.3 Reprezentacja planszy w pamięci
Plansza gry jest reprezentowana jako dwuwymiarowy wektor typów znakowych:

Taka struktura umożliwia dynamiczną alokację pamięci dla 10 wierszy i 10 kolumn. Dostęp do dowolnego pola odbywa się poprzez podanie współrzędnych [wiersz][kolumna] w zakresie od 0 do 9.
4. Pełny Kod Źródłowy Programu (C++)
#include <iostream>
#include <vector>
#include <cstdlib>
#include <ctime>

using namespace std;

// Stale globalne konfigurujace gre
const int ROZMIAR = 10;
const int LICZBA_STATKOW = 5;

// Funkcja tworzaca i inicjalizujaca pusta plansze 10x10
vector<vector<char>> tworzPlansze() {
    return vector<vector<char>>(ROZMIAR, vector<char>(ROZMIAR, '.'));
}

// Funkcja odpowiedzialna za wyswietlanie planszy w konsoli
void rysujPlansze(const vector<vector<char>>& plansza, bool ukryjStatki = false) {
    cout << "  ";
    for (int i = 0; i < ROZMIAR; ++i) {
        cout << i << " ";
    }
    cout << endl;

    for (int i = 0; i < ROZMIAR; ++i) {
        cout << i << " ";
        for (int j = 0; j < ROZMIAR; ++j) {
            if (ukryjStatki && plansza[i][j] == 'S') {
                cout << ". ";
            } else {
                cout << plansza[i][j] << " ";
            }
        }
        cout << endl;
    }
}

// Funkcja losowo rozstawiajaca statki komputera
void ustawStatkiKomputera(vector<vector<char>>& plansza) {
    int ustawione = 0;
    while (ustawione < LICZBA_STATKOW) {
        int wiersz = rand() % ROZMIAR;
        int kolumna = rand() % ROZMIAR;
        if (plansza[wiersz][kolumna] == '.') {
            plansza[wiersz][kolumna] = 'S';
            ustawione++;
        }
    }
}

// Funkcja pobierajaca pozycje statkow od gracza wraz z walidacja
void ustawStatkiGracza(vector<vector<char>>& plansza) {
    int ustawione = 0;
    while (ustawione < LICZBA_STATKOW) {
        int wiersz, kolumna;
        cout << "Podaj pozycje dla statku " << ustawione + 1 << " (wiersz kolumna): ";
        if (!(cin >> wiersz >> kolumna)) {
            cin.clear();
            cin.ignore(10000, '\n');
            cout << "Bledny format danych! Wpisz dwie liczby z zakresu 0-9.\n";
            continue;
        }
        
        if (wiersz >= 0 && wiersz < ROZMIAR && kolumna >= 0 && kolumna < ROZMIAR && plansza[wiersz][kolumna] == '.') {
            plansza[wiersz][kolumna] = 'S';
            ustawione++;
        } else {
            cout << "Niepoprawne wspolrzedne lub pole jest juz zajete! Sprobuj ponownie.\n";
        }
    }
}

// Obsluga tury gracza (oddanie strzalu)
bool turaGracza(vector<vector<char>>& plansza) {
    int wiersz, kolumna;
    while (true) {
        cout << "Podaj wspolrzedne strzalu (wiersz kolumna): ";
        if (!(cin >> wiersz >> kolumna)) {
            cin.clear();
            cin.ignore(10000, '\n');
            cout << "Bledny format danych! Podaj dwie liczby.\n";
            continue;
        }
        if (wiersz < 0 || wiersz >= ROZMIAR || kolumna < 0 || kolumna >= ROZMIAR) {
            cout << "Wspolrzedne poza plansza! Podaj wartosci od 0 do 9.\n";
            continue;
        }
        if (plansza[wiersz][kolumna] == 'X' || plansza[wiersz][kolumna] == 'O') {
            cout << "Juz strzelales w to miejsce! Wybierz inne pole.\n";
            continue;
        }
        if (plansza[wiersz][kolumna] == 'S') {
            cout << ">>> TRAFIONY! <<<\n";
            plansza[wiersz][kolumna] = 'X';
            return true;
        } else {
            cout << ">>> PUDLO! <<<\n";
            plansza[wiersz][kolumna] = 'O';
            return false;
        }
    }
}

// Obsluga tury komputera (losowy strzal w niewykorzystane pole)
bool turaKomputera(vector<vector<char>>& plansza) {
    int wiersz, kolumna;
    do {
        wiersz = rand() % ROZMIAR;
        kolumna = rand() % ROZMIAR;
    } while (plansza[wiersz][kolumna] == 'X' || plansza[wiersz][kolumna] == 'O');

    cout << "Komputer strzela w pole [" << wiersz << "][" << kolumna << "] - ";
    if (plansza[wiersz][kolumna] == 'S') {
        cout << "TRAFIL TWOJ STATEK!\n";
        plansza[wiersz][kolumna] = 'X';
        return true;
    } else {
        cout << "PUDLO!\n";
        plansza[wiersz][kolumna] = 'O';
        return false;
    }
}

int main() {
    // Inicjalizacja generatora liczb losowych czasem systemowym
    srand(time(0));

    // Tworzenie plansz dla obu uczestnikow
    vector<vector<char>> planszaGracza = tworzPlansze();
    vector<vector<char>> planszaKomputera = tworzPlansze();

    cout << "=================================\n";
    cout << "     GRA W STATKI 10x10 - C++    \n";
    cout << "=================================\n\n";

    cout << "--- USTAWIANIE STATKOW GRACZA ---\n";
    ustawStatkiGracza(planszaGracza);
    ustawStatkiKomputera(planszaKomputera);

    int statkiKomputera = LICZBA_STATKOW;
    int statkiGracza = LICZBA_STATKOW;

    // Glowna petla rozgrywki
    while (statkiKomputera > 0 && statkiGracza > 0) {
        cout << "\n=================================\n";
        cout << "PLANSZA KOMPUTERA (Przeciwnika):\n";
        rysujPlansze(planszaKomputera, true);

        cout << "\nPLANSZA GRACZA (Twoja flota):\n";
        rysujPlansze(planszaGracza, false);

        cout << "\n--- TURA GRACZA ---\n";
        if (turaGracza(planszaKomputera)) {
            statkiKomputera--;
        }

        if (statkiKomputera == 0) {
            break; // Wygrana gracza - natychmiastowe zakonczenie petli
        }

        cout << "\n--- TURA KOMPUTERA ---\n";
        if (turaKomputera(planszaGracza)) {
            statkiGracza--;
        }
    }

    // Ekran koncowy gry
    cout << "\n=================================\n";
    if (statkiKomputera == 0) {
        cout << "   GRATULACJE! WYGRALES!   \n";
    } else {
        cout << "   PRZEGRALES! Bot wygral.  \n";
    }
    cout << "=================================\n";

    return 0;
}

5. Szczegółowy Opis Funkcji i Modułów
5.1 Moduł Inicjalizacji: tworzPlansze()
 * Sygnatura: vector<vector<char>> tworzPlansze()
 * Opis: Funkcja nie przyjmuje parametrów. Tworzy dwuwymiarową strukturę vector o wymiarach 10 \times 10 i wypełnia każde z 100 pól znakiem kropki '.'.
 * Zastosowanie: Wywoływana dwukrotnie w funkcji main() w celu utworzenia osobnych plansz dla gracza oraz bota.
5.2 Moduł Wizualizacji: rysujPlansze()
 * Sygnatura: void rysujPlansze(const vector<vector<char>>& plansza, bool ukryjStatki)
 * Opis: Odpowiada za wypisanie siatki gry w konsoli.
 * Parametry:
   * plansza – stała referencja (const &), która zapobiega niepotrzebnemu kopiowaniu planszy w pamięci RAM i uniemożliwia jej przypadkową modyfikację.
   * ukryjStatki – wartość logiczna (bool). Jeśli wynosi true, funkcja zamienia litery 'S' na kropki '.'. Dzięki temu statki komputera są ukryte przed graczem.
5.3 Moduł Ustawiania Statków Komputera: ustawStatkiKomputera()
 * Sygnatura: void ustawStatkiKomputera(vector<vector<char>>& plansza)
 * Opis: Korzysta z pętli while oraz generatora rand() % ROZMIAR. Losuje pozycję wiersza i kolumny. Jeśli wskazane pole jest puste ('.'), stawia statek ('S') i zwiększa licznik ustawionych jednostek.
5.4 Moduł Ustawiania Statków Gracza: ustawStatkiGracza()
 * Sygnatura: void ustawStatkiGracza(vector<vector<char>>& plansza)
 * Opis: W pętli prosi gracza o podanie dwóch liczb z klawiatury. Zawiera rozbudowaną walidację danych wejściowych:
   * Sprawdza, czy wprowadzono liczby (obsługa błędu strumienia cin.fail()).
   * Sprawdza, czy mieści się w granicach 0 \le wiersz < 10 oraz 0 \le kolumna < 10.
   * Sprawdza, czy pole nie zawiera już innego statku.
5.5 Moduły Logiki Strzałów: turaGracza() i turaKomputera()
 * turaGracza: Wczytuje strzał gracza. Jeśli gracz trafi w statek komputera ('S'), wpisuje znak 'X' i zwraca true. W przypadku strzału w wodę wpisuje 'O' i zwraca false. Ponowne strzały w pola 'X' lub 'O' są odrzucane z komunikatem błędu.
 * turaKomputera: Komputer losuje pola w pętli do-while do momentu natrafienia na pole, w które jeszcze nie strzelał (różne od 'X' i 'O').
